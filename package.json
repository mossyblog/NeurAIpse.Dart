{
  "name": "@neuraipse/annotate",
  "version": "0.6.0",
  "type": "module",
  "license": "MIT",
  "description": "Standalone dev-only UI feedback and design-token inspector overlay for React apps and AI coding agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mossyblog/NeurAIpse.Dart.git"
  },
  "homepage": "https://github.com/mossyblog/NeurAIpse.Dart#readme",
  "files": [
    "dist",
    "src",
    "scripts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build:styles": "node scripts/build-styles.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build:styles && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "npm run build:styles && tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "cn": "^0.5.2",
    "lucide-react": "^1.76.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^31.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
